<section class="color-{{ section.settings.color_scheme }} bg-background text-foreground">
  <div class="container-page section-y">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {%- for block in section.blocks -%}
        <div class="flex flex-col items-start gap-3" {{ block.shopify_attributes }}>
          <span class="btn-icon size-12 bg-foreground/5">
            {%- render 'icon', name: block.settings.icon, class: 'size-5' -%}
          </span>
          <h3 class="text-base font-semibold">{{ block.settings.heading }}</h3>
          <p class="text-sm text-foreground/70">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "value_prop",
      "name": "Value prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping" },
            { "value": "refresh", "label": "Returns" },
            { "value": "shield-check", "label": "Security" },
            { "value": "headset", "label": "Support" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On all orders over $75"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "value_prop", "settings": { "icon": "truck", "heading": "Free shipping", "text": "On all orders over $75" } },
        { "type": "value_prop", "settings": { "icon": "refresh", "heading": "Easy returns", "text": "30-day return policy" } },
        { "type": "value_prop", "settings": { "icon": "shield-check", "heading": "Secure checkout", "text": "128-bit SSL encryption" } },
        { "type": "value_prop", "settings": { "icon": "headset", "heading": "24/7 support", "text": "Here whenever you need us" } }
      ]
    }
  ]
}
{% endschema %}
