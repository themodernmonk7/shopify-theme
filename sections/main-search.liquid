<div class="color-{{ section.settings.color_scheme }} bg-background text-foreground">
  <div class="container-page section-y">
    <div class="mb-8 flex flex-col gap-3 border-b border-border pb-8 md:mb-12 md:pb-10">
      <h1 class="text-h1 font-heading font-bold">{{ 'general.search.title' | t: default: 'Search' }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="flex max-w-md gap-2">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t: default: 'Search products' }}" class="input-field">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn-primary shrink-0">{{ 'general.search.submit' | t: default: 'Search' }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="mb-6 text-sm text-foreground/60">
          {{ search.results_count }} {{ 'general.search.results_for' | t: default: 'results for' }} &ldquo;{{ search.terms }}&rdquo;
        </p>
        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 lg:grid-cols-4 lg:gap-x-8">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item, section_id: section.id -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="rounded-md border border-dashed border-border p-16 text-center text-foreground/60">
          {{ 'general.search.no_results' | t: default: 'No results found for' }} &ldquo;{{ search.terms }}&rdquo;
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
