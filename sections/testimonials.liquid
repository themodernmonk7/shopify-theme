<section class="color-{{ section.settings.color_scheme }} bg-background text-foreground">
  <div class="container-page section-y">
    {%- if section.settings.heading != blank -%}
      <h2 class="mb-10 text-center text-h2 font-heading font-bold md:mb-14">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {%- for block in section.blocks -%}
        <div class="card flex flex-col gap-4 p-6" {{ block.shopify_attributes }}>
          <div class="flex gap-0.5 text-accent">
            {%- assign rating = block.settings.rating | times: 1 -%}
            {%- for i in (1..5) -%}
              {%- if i <= rating -%}
                {%- render 'icon', name: 'star', class: 'size-4' -%}
              {%- else -%}
                {%- render 'icon', name: 'star-outline', class: 'size-4' -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="grow text-sm text-foreground/80">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="text-sm font-semibold">{{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by our customers"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality exceeded my expectations. Fast shipping and beautiful packaging too."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Happy customer"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
