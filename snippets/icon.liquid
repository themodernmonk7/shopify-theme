{%- comment -%}
  Renders an inline SVG icon.

  Accepts:
  - name: required. One of the case values below.
  - class: optional. Extra classes; size the icon with text-size or
    explicit w-/h- utilities from the caller (icons default to 1.5em
    square so they scale with the surrounding font-size token).

  Usage: {% render 'icon', name: 'cart', class: 'w-5 h-5' %}
{%- endcomment -%}

{%- liquid
  assign icon_class = class | default: 'size-5'
-%}

<svg class="{{ icon_class }} shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M3 3h2l.4 2M7 13h10l3-8H5.4M7 13L5.4 5M7 13l-1.7 6.4A1 1 0 0 0 6.3 20.7H18" />
      <circle cx="9" cy="21" r="1" fill="currentColor" stroke="none" />
      <circle cx="18" cy="21" r="1" fill="currentColor" stroke="none" />
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7" />
      <path d="m21 21-4.35-4.35" />
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4" />
      <path d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6" />
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16" />
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18" />
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6" />
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6" />
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6" />
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6" />
    {%- when 'star' -%}
      <path d="m12 3 2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1L6.6 19.4l1.3-6-4.6-4.2 6.1-.6L12 3Z" fill="currentColor" stroke="none" />
    {%- when 'star-outline' -%}
      <path d="m12 3 2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1L6.6 19.4l1.3-6-4.6-4.2 6.1-.6L12 3Z" />
    {%- when 'truck' -%}
      <path d="M2 7h11v9H2z" />
      <path d="M13 10h4l4 3v3h-8z" />
      <circle cx="6.5" cy="18" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="16.5" cy="18" r="1.5" fill="currentColor" stroke="none" />
    {%- when 'shield-check' -%}
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" />
      <path d="m9 12 2 2 4-4" />
    {%- when 'refresh' -%}
      <path d="M4 4v5h5" />
      <path d="M20 20v-5h-5" />
      <path d="M4.5 15a8 8 0 0 0 14.1 2.5M19.5 9A8 8 0 0 0 5.4 6.5" />
    {%- when 'headset' -%}
      <path d="M4 13a8 8 0 0 1 16 0" />
      <rect x="2.5" y="13" width="4" height="6" rx="1.5" />
      <rect x="17.5" y="13" width="4" height="6" rx="1.5" />
      <path d="M20 19v1a3 3 0 0 1-3 3h-3" />
    {%- when 'minus' -%}
      <path d="M5 12h14" />
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14" />
    {%- when 'check' -%}
      <path d="m5 13 4 4L19 7" />
    {%- when 'trash' -%}
      <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" />
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9" rx="1.5" />
      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
    {%- when 'facebook' -%}
      <path d="M14 9h3V6h-3a4 4 0 0 0-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1Z" fill="currentColor" stroke="none" />
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none" />
    {%- when 'x-social' -%}
      <path d="M4 4l16 16M20 4 4 20" />
    {%- when 'youtube' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="3" />
      <path d="M10.5 9.5v5l4.5-2.5Z" fill="currentColor" stroke="none" />
    {%- when 'tiktok' -%}
      <path d="M14 4v9.5a3.5 3.5 0 1 1-3.5-3.5" />
      <path d="M14 4c0 2.2 1.8 4 4 4" />
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M9.5 17c1-3 1.5-5 1.5-6.5a2 2 0 0 1 4 .3c0 1.7-1 3.7-2.5 3.7-1 0-1.5-.8-1.5-1.8" />
  {%- endcase -%}
</svg>
