{%- comment -%}
  Renders the list of cart line items. Shared by the cart drawer
  and the full cart page so both stay visually and behaviorally
  identical.

  Accepts:
  - cart: required.
  - compact: optional boolean, default false. Tightens spacing and
    image size for the drawer.
{%- endcomment -%}

{%- liquid
  assign image_size = 96
  assign gap_class = 'gap-4 py-5'
  if compact
    assign image_size = 80
    assign gap_class = 'gap-3 py-4'
  endif
-%}

<ul class="divide-y divide-border" data-cart-items>
  {%- for item in cart.items -%}
    <li class="flex {{ gap_class }}" data-cart-item data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="shrink-0 overflow-hidden rounded-sm bg-foreground/5">
        {%- if item.image -%}
          <img
            src="{{ item.image | image_url: width: 200 }}"
            alt="{{ item.image.alt | escape }}"
            width="{{ image_size }}"
            height="{{ image_size }}"
            loading="lazy"
            class="object-cover"
            style="width: {{ image_size }}px; height: {{ image_size }}px;"
          >
        {%- endif -%}
      </a>

      <div class="flex flex-1 flex-col gap-1">
        <div class="flex items-start justify-between gap-3">
          <a href="{{ item.url }}" class="text-sm font-medium line-clamp-2">{{ item.product.title }}</a>
          <button
            type="submit"
            name="updates[{{ forloop.index }}]"
            value="0"
            class="btn-icon size-8 shrink-0"
            data-cart-remove
            data-line="{{ forloop.index }}"
            aria-label="{{ 'sections.cart.remove' | t: default: 'Remove' }}"
          >
            {%- render 'icon', name: 'trash', class: 'size-4' -%}
          </button>
        </div>

        {%- unless item.variant.title == 'Default Title' -%}
          <p class="text-xs text-foreground/60">{{ item.variant.title }}</p>
        {%- endunless -%}

        <div class="mt-1 flex items-center justify-between gap-3">
          <div class="inline-flex items-center rounded-sm ring-1 ring-border ring-inset">
            <button type="button" class="btn-icon size-8 rounded-sm" data-quantity-step="-1" data-line="{{ forloop.index }}" aria-label="{{ 'products.product.decrease_quantity' | t: default: 'Decrease quantity' }}">
              {%- render 'icon', name: 'minus', class: 'size-3.5' -%}
            </button>
            <input
              type="number"
              class="w-10 border-0 bg-transparent text-center text-sm focus-visible:outline-none"
              name="updates[{{ forloop.index }}]"
              value="{{ item.quantity }}"
              min="0"
              inputmode="numeric"
              data-quantity-input
              data-line="{{ forloop.index }}"
              aria-label="{{ 'products.product.quantity' | t: default: 'Quantity' }}"
            >
            <button type="button" class="btn-icon size-8 rounded-sm" data-quantity-step="1" data-line="{{ forloop.index }}" aria-label="{{ 'products.product.increase_quantity' | t: default: 'Increase quantity' }}">
              {%- render 'icon', name: 'plus', class: 'size-3.5' -%}
            </button>
          </div>
          <span class="text-sm font-semibold">{{ item.final_line_price | money }}</span>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
